{
  "compilerOptions": {
    "noEmit": true,
    "declaration": true,
    "isolatedModules": true,
    "strict": true,
    "noUnusedLocals": true,
    "skipLibCheck": true,
    "target": "ES2020",
    "module": "NodeNext",
    "lib": ["ES2020"],
    "types": ["node"],
    "verbatimModuleSyntax": true,
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": true,
    "outDir": "./lib"
  },
  "include": ["./src/**/*"]
}
